# Copie para .env.local (desenvolvimento) ou cadastre na Vercel em Settings > Environment Variables.

# Endereço final do site (usado na imagem de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://nhandu.com.br

# WhatsApp da Nhandu, só números com DDI e DDD (ex.: 5514999990000). Liga os botões "Falar com o agente".
NEXT_PUBLIC_WHATSAPP=

# CNPJ exibido no rodapé e nas páginas legais
NEXT_PUBLIC_CNPJ=

# E-mail de contato exibido nas páginas legais
NEXT_PUBLIC_CONTATO_EMAIL=contato@nhandu.com.br

# Destino dos pedidos de diagnóstico (use pelo menos um)
# 1) Webhook: n8n, Make, Zapier ou Google Apps Script que grava numa planilha
DIAGNOSTICO_WEBHOOK_URL=
# 2) E-mail via Resend (resend.com): chave da API e e-mail que recebe os pedidos
RESEND_API_KEY=
DIAGNOSTICO_EMAIL=
DIAGNOSTICO_EMAIL_FROM=Nhandu <site@nhandu.com.br>
